    <script>
        // Toggle task completion
        function toggleTask(element) {
            // Do not toggle icon for descanso tasks with mug icon
            const icon = element.querySelector('.check-icon');
            
            if (element.classList.contains('task-done')) {
                element.classList.remove('task-done');
                if (icon) {
                    icon.className = 'fa-regular fa-circle text-slate-400 check-icon';
                }
            } else {
                element.classList.add('task-done');
                if (icon) {
                    icon.className = 'fa-solid fa-circle-check text-emerald-500 check-icon';
                }
                showToast('Tarefa concluída! Parabéns! 🎉');
            }
        }

        // Action when clicking "Acesse aqui"
        function openLink(day) {
            showToast(`Acessando materiais de ${day}...`, 'fa-solid fa-folder-open text-blue-400');
        }

        // Reset all completed tasks
        function resetTasks() {
            const tasks = document.querySelectorAll('.task-card');
            tasks.forEach(task => {
                task.classList.remove('task-done');
                const icon = task.querySelector('.check-icon');
                if (icon) {
                    icon.className = 'fa-regular fa-circle text-slate-400 check-icon';
                }
            });
            showToast('Progresso semanal resetado com sucesso!');
        }

        // Toast notification system
        function showToast(message, iconClass = 'fa-solid fa-circle-check text-emerald-400') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = message;
            toastIcon.className = iconClass;

            toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }, 3000);
        }

        // Modal for Notes
        function openNoteModal() {
            const modal = document.getElementById('notes-modal');
            const savedNote = localStorage.getItem('study_notes') || '';
            document.getElementById('notes-text').value = savedNote;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closeNoteModal() {
            const modal = document.getElementById('notes-modal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function saveNotes() {
            const text = document.getElementById('notes-text').value;
            localStorage.setItem('study_notes', text);
            closeNoteModal();
            showToast('Anotações salvas com sucesso!');
        }
    </script>
