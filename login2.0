<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login de Conta - TaskUp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      /* Gradiente de fundo */
      background: linear-gradient(135deg, #02020a 0%, #0d1245 45%, #232cae 100%);
      color: #ffffff;
      padding: 30px 20px;
    }

    .form-container {
      width: 100%;
      max-width: 850px;
      margin-top: 20px;
    }

    /* Título principal */
    .page-title {
      font-size: 2.2rem;
      font-weight: 500;
      color: #00bcd4; /* Cor ciano/azul claro do título */
      margin-bottom: 25px;
    }

    /* Campos de entrada (Inputs) */
    .form-group {
      margin-bottom: 25px;
    }

    .form-group label {
      display: block;
      font-size: 1.1rem;
      color: #8fa0dd;
      margin-bottom: 8px;
    }

    .input-field {
      width: 100%;
      height: 48px;
      background: rgba(10, 18, 45, 0.6);
      border: 1px solid #1a2a6c;
      border-radius: 8px;
      padding: 0 15px;
      color: #ffffff;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.3s;
    }

    .input-field:focus {
      border-color: #00bcd4;
    }

    /* Grupo de Opções de Horário */
    .options-label {
      font-size: 1.1rem;
      color: #8fa0dd;
      margin-bottom: 15px;
      display: block;
    }

    .options-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 35px;
    }

    .option-btn {
      width: 100%;
      padding: 14px 20px;
      background: rgba(10, 18, 45, 0.5);
      border: 1px solid #1a2350;
      border-radius: 8px;
      color: #7988c7;
      font-size: 1rem;
      text-align: left;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .option-btn:hover {
      background: rgba(20, 32, 75, 0.8);
      border-color: #2b3eb2;
      color: #ffffff;
    }

    /* Botão Ok */
    .submit-btn {
      width: 100%;
      padding: 14px;
      background-color: #90c8ff;
      border: none;
      border-radius: 25px;
      color: #0d1245;
      font-size: 1.2rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.3s ease;
      margin-bottom: 15px;
    }

    .submit-btn:hover {
      background-color: #b3d9ff;
    }

    /* Rodapé com aviso e contato */
    footer {
      text-align: center;
      margin-top: 20px;
    }

    .disclaimer {
      font-size: 0.75rem;
      color: #58669e;
      margin-bottom: 20px;
    }

    .help-section {
      font-size: 0.95rem;
      color: #ffffff;
      line-height: 1.4;
      font-weight: 600;
    }

    .help-section span {
      display: block;
    }

    /* Responsividade */
    @media (max-width: 600px) {
      .page-title {
        font-size: 1.8rem;
      }
      .option-btn {
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>

  <main class="form-container">
    <h1 class="page-title">Login de conta</h1>

    <form action="#" method="POST">
      <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" id="nome" name="nome" class="input-field" required>
      </div>

      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" class="input-field" required>
      </div>

      <label class="options-label">Qual horário e horas você prefere estudar?</label>
      
      <div class="options-group">
        <button type="button" class="option-btn">Manhã (1 à 3 hrs no dia)</button>
        <button type="button" class="option-btn">Manhã (3 à 5 hrs no dia)</button>
        <button type="button" class="option-btn">Tarde (1 à 3 hrs no dia)</button>
        <button type="button" class="option-btn">Tarde(3 à 5 hrs no dia)</button>
      </div>

      <a href="index.html" style="text-decoration: none;">
        <button type="button" class="submit-btn">Ok</button>
      </a>
    </form>
  </main>

  <footer>
    <p class="disclaimer">Seu nome de perfil no Canva não será compartilhado. Nunca envie senhas.</p>
    
    <div class="help-section">
      <span>Precisa de ajuda?</span>
      <span>entre em contato:</span>
      <span>44998913918</span>
    </div>
  </footer>

</body>
</html>
